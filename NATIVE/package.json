{
  "name": "tirta-standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "native:win": "npm run build && electron-builder --win portable --x64",
    "native:android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "lucide-react": "1.45.0",
    "pdfmake": "^0.3.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "main": "native/electron/main.cjs",
  "build": {
    "appId": "id.tirta.rainplanner",
    "productName": "TIRTA",
    "asar": true,
    "files": [
      "dist/**/*",
      "native/electron/main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "native-dist/windows"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TIRTA.exe",
      "icon": "native/electron/tirta.ico"
    }
  }
}
